# Trace always runs with deterministic sample data when these are blank.
PORT=4310
SAMPLE_MODE=true

# Required for the live sponsor integration. Never commit real values.
# Full OpenSqlQuery endpoint for your Zetaris tenant. Trace sends
# { "select": "...", "pageLimit": 100 } with bearer authentication.
ZETARIS_QUERY_URL=
ZETARIS_ID_TOKEN=
ZETARIS_ADS_SQL=SELECT * FROM trace.ads
ZETARIS_CRM_SQL=SELECT * FROM trace.crm
ZETARIS_BILLING_SQL=SELECT * FROM trace.billing
ZETARIS_SUPPORT_SQL=SELECT * FROM trace.support

# NVIDIA's standard key name is preferred. Trace automatically uses the
# hosted chat-completions endpoint when this is set.
NVIDIA_API_KEY=
# Optional overrides for a hackathon-provided or self-hosted NIM endpoint.
NEMOTRON_CHAT_URL=
NEMOTRON_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
